    "Start": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıç"
          }
        }
      }
    },
    "Start and end can't be the same time.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıç ve bitiş aynı saat olamaz."
          }
        }
      }
    },
    "Sync Off": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senkron Kapalı"
          }
        }
      }
    },
    "Sync On": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senkron Açık"
          }
        }
      }
    },
    "Sync window": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senkron saatleri"
          }
        }
      }
    },
    "What to pause": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neler duraklatılsın"
          }
        }
      }
    },
    "While paused, files stored only in iCloud (cloud icon in Finder) can't open until sync runs.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duraklatılmışken yalnızca iCloud'da duran dosyalar (Finder'da bulut simgeli) senkron devam edene kadar açılamaz."
          }
        }
      }
    }
  },
  "version": "1.0"
}